// Configuration du Worker Cloudflare « bristol-eps ».
// Les secrets (ANTHROPIC_API_KEY, ACCESS_CODES) se règlent dans le tableau de bord
// Cloudflare et ne figurent jamais dans ce fichier.
{
  "name": "bristol-eps",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Adresse publique en .workers.dev ; pas d'adresses de prévisualisation par version.
  "workers_dev": true,
  "preview_urls": false,
  // Garde les variables ajoutées dans le tableau de bord lors des déploiements.
  "keep_vars": true,
  // Identifiant client Google (public). Le secret GOOGLE_CLIENT_SECRET se règle dans Cloudflare.
  "vars": { "GOOGLE_CLIENT_ID": "1097426763420-4goof9jn1u4cvq1qb2qtrl4fpvs47nf4.apps.googleusercontent.com" },
  // Compteur des retours par code d'accès et par mois.
  "kv_namespaces": [{ "binding": "QUOTA", "id": "49e3556c30ab46efa24e2238914a5d66" }],
  // Comptes utilisateurs et progression synchronisée (schéma : migrations/).
  "d1_databases": [{ "binding": "DB", "database_name": "bristol-db", "database_id": "00f08cde-346f-42f4-9d4e-ad6f6930032a", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
